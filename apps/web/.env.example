# Public values. Never add SUPABASE_SERVICE_ROLE_KEY to this application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Canonical web origin used for email and OAuth callbacks in deployed web builds.
# Local development keeps http://localhost:3000 automatically.
APP_URL=https://talentsouq.it.com

# Optional server-side aliases used by some hosts/dashboards.
# These must still be public publishable/anon values, never service-role/secret keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional, privacy-safe error monitoring configuration.
NEXT_PUBLIC_ERROR_MONITORING_DSN=
